rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------
    // 1. GLOBAL HELPERS
    // ------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ------------------------------------------------------------
    // 2. ENTITY VALIDATORS
    // ------------------------------------------------------------
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt is timestamp;
    }

    function isValidScan(data) {
      return data.keys().hasAll(['userId', 'imageUrl', 'diagnosis', 'createdAt']) &&
             data.keys().size() <= 12 &&
             data.userId == request.auth.uid &&
             data.imageUrl is string && data.imageUrl.size() <= 2048 &&
             (data.get('gradcamImage', null) == null || data.gradcamImage is string) &&
             data.diagnosis is string && data.diagnosis.size() <= 500 &&
             (data.get('medicalReport', null) == null || data.medicalReport is string) &&
             (data.get('patientName', null) == null || data.patientName is string) &&
             (data.get('patientId', null) == null || data.patientId is string) &&
             data.createdAt is timestamp;
    }

    // ------------------------------------------------------------
    // 3. DEFAULT DENY
    // ------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------
    // 4. COLLECTION RULES
    // ------------------------------------------------------------

    // User Profile
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUser(incoming());
      allow update: if isOwner(uid) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])
      );
    }

    // scans
    match /scans/{scanId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidScan(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
